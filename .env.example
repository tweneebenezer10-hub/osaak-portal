# ─────────────────────────────────────────────────────────────────────────────
# CONNEZER EDUTECH SYSTEMS — Environment Variables
# Copy this file to .env for local development ONLY.
# In production (Vercel / Render), set these as Environment Variables in the project dashboard.
# NEVER commit .env or config/local.php to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=CONNEZER EDUTECH SYSTEMS
# Local: http://localhost/school-dev   Production: https://your-project.vercel.app
APP_URL=https://your-project.vercel.app
APP_TIMEZONE=Africa/Accra
RECEIPT_FINANCIAL_TITLE=CONNEZER EDUTECH SYSTEMS

# ── Security secrets (generate unique values — min 32 chars) ─────────────────
# Run: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;" (twice, use different values)
AUTH_PEPPER=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_KEY=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# ── Database (MySQL / TiDB / PlanetScale / Aiven / Remote MySQL) ─────────────
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=secure_auth_system
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_CHARSET=utf8mb4
DB_SSL=true
DB_SSL_CA=

# ── Mail (SMTP — Gmail App Password recommended) ─────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_EMAIL=your-email@gmail.com
MAIL_FROM_NAME=CONNEZER EDUTECH SYSTEMS

# ── AI Integration (Optional — Ollama endpoint) ──────────────────────────────
OLLAMA_BASE_URL=https://your-private-ollama-host
OLLAMA_MODEL=granite3.3:2b
