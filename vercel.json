{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "^/(assets|css|js)/(.*\\.(css|js|map|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp|avif))$",
      "dest": "/public/assets/$1/$2"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/public/assets/$1"
    },
    {
      "src": "^/service-worker(-v2)?\\.js$",
      "dest": "/public/service-worker$1.js"
    },
    {
      "src": "^/manifest\\.webmanifest$",
      "dest": "/public/manifest.webmanifest"
    },
    {
      "src": "^/favicon\\.ico$",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "^/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
